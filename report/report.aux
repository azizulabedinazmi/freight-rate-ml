\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces MAE by fold. The boosted model wins in two of three folds; in Jul--Aug a baseline fit on Jan--Jun happened to track that window slightly better.}}{4}{figure.caption.8}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces MAE (\$) per fold.}}{4}{table.caption.9}\protected@file@percent }
